# FreePDFEdit Environment Variables

# Canonical site URL (update once you attach a custom domain)
# VITE_SITE_URL=https://freepdfediting.netlify.app

# Set to true only after configuring your Google AdSense publisher ID and slot IDs below
VITE_SHOW_ADS=false

# Optional Google AdSense settings (leave blank until your site is approved)
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT_TOP=
# VITE_ADSENSE_SLOT_SIDE=
# VITE_ADSENSE_SLOT_BOTTOM=

# (Optional) Custom recipient email for the feedback form
# VITE_FEEDBACK_RECEIVER=your-email@example.com

# (Optional) FormSubmit anonymized token to completely hide recipient address in network calls
# VITE_FORMSUBMIT_TOKEN=

# Gmail SMTP credentials for OTP verification, feedback & Buy Me a Coffee thank-you emails
# Generate a 16-character Google App Password in Google Account -> Security -> App passwords
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_FROM_NAME=FreePDFEdit

# Private server-side UPI ID for Buy Me a Coffee QR & deep links (never shown in UI or committed to git)
# UPI_VPA=your-upi-id@bank
# UPI_PAYEE_NAME=Manish Bhavar